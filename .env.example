# Resultado de la compra simulada; únicamente lo lee el backend de Pagos.
# Valores: approved (predeterminado) o rejected (pruebas de rechazo).
PAYMENT_SIMULATOR_RESULT=approved
PAGOS_MONGODB_DATABASE=pagos_db

# Verificación de roles del Catálogo en Auth (Compose local).
AUTH_URL=http://auth:8084

# Zona local usada para agendas y selección de horarios de Reservas.
MELT_TIMEZONE=America/Argentina/Buenos_Aires

# Clave interna compartida por Auth, Catálogo, Reservas, Pagos y Beneficios.
MELT_INTERNAL_KEY=
# Clave del consumidor externo, exclusivamente servidor a servidor.
BENEFICIOS_PARTNER_KEY=

# Secreto distinto, estable y de al menos 32 caracteres para enlaces de invitación.
BENEFICIOS_INVITATION_SECRET=
# URL pública confiable del frontend/gateway; no se toma de headers del cliente.
MELT_PUBLIC_URL=http://localhost:8080

# Bases separadas para pruebas en un mismo clúster. Valores predeterminados:
AUTH_MONGODB_DATABASE=usuarios_db
BENEFICIOS_MONGODB_DATABASE=beneficios_db

# Catálogo: mantener los nombres existentes en instalaciones con datos.
CATALOGO_MONGODB_DATABASE=catalogo_db
# Vacío usa la misma base de Catálogo. Una base distinta requiere migración explícita.
PROFESIONALES_MONGODB_DATABASE=
