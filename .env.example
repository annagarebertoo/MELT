# Usar únicamente credenciales de prueba de Mercado Pago.
MP_ENV=test
MP_ACCESS_TOKEN=
MP_BASE_URL=https://api.mercadopago.com
# Opcional: retorno HTTPS público luego del checkout aprobado o rechazado.
MP_RETURN_URL=

# Verificación de roles del Catálogo en Auth (Compose local).
AUTH_URL=http://auth:8084

# Zona local usada para agendas y selección de horarios de Reservas.
MELT_TIMEZONE=America/Argentina/Buenos_Aires

# Integración del Grupo 1 (gimnasio) - valores de ejemplo para desarrollo.
# El gimnasio agrega ?referencia=CODIGO_GIMNASIO al enlace y envía
# codigoReferido en POST /api/v1/auth/registro.
CODIGO_GIMNASIO=GIMNASIO_MELT_DEV
# Secreto interno compartido solo entre Auth y Beneficios; generar uno aleatorio.
MELT_INTERNAL_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
# Regalo fijo por primera alta desde el enlace del gimnasio.
PUNTOS_REGISTRO_GIMNASIO=100
